---
import Layout from '../layouts/Layout.astro';
import SubjectCard from '../components/SubjectCard.astro';
import BentoHero from '../components/BentoHero.astro';
import subjects from '../data/subjects.json';
import { getData } from '../lib/data.js';
import { SITE_URL } from '../lib/constants';

// Build subject data with chapter/video counts
const subjectCards = subjects.map(s => {
  const data = getData(s.id);
  const chapters = data.chapters;
  const chapterCount = chapters.length;
  let videoCount = 0;
  for (const ch of chapters) {
    if (ch.videoCount) {
      videoCount += ch.videoCount;
    } else if (ch.sections) {
      for (const sec of ch.sections) {
        videoCount += (sec.videos || []).length;
      }
    } else if (ch.videos) {
      videoCount += ch.videos.length;
    }
  }
  return { ...s, chapterCount, videoCount };
});
---

<Layout
  title="Class 9 Hub – Free Lectures for Punjab Board | Math, Physics, Chemistry & More"
  desc="Free class 9 lectures for Punjab Board 2026. Watch physics, math, chemistry, computer, urdu, biology and english video lectures online. Full chapter-wise course."
  canonical={SITE_URL}
  noHeader={true}
>
  <!-- Hero -->
  <BentoHero />

  <!-- Subjects Grid -->
  <section class="pt-4 pb-10 sm:pb-14">
    <div class="flex items-end justify-between mb-6">
      <div>
        <h2 class="text-[22px] sm:text-[24px] font-normal tracking-tight" style="font-family: var(--font-display); color: var(--text-primary);">Browse Subjects</h2>
        <p class="text-[13px] mt-0.5" style="color: var(--text-muted);">All {subjects.length} Punjab Board subjects, chapter by chapter</p>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
      {subjectCards.map((s, i) => (
        <div class={`anim d${i + 1}`}>
          <SubjectCard
            id={s.id}
            title={s.title}
            accent={s.accent}
            chapterCount={s.chapterCount}
            videoCount={s.videoCount}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- IntersectionObserver for scroll animations -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.anim').forEach(function(el) { observer.observe(el); });
    });
  </script>

  <!-- Progress indicator script -->
  <script is:inline>
    (function() {
      var RECENT_KEY = 'c9-recent';
      var recent = [];
      try { recent = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch(e) {}

      // Group by subject, get last watched per subject
      var lastBySubject = {};
      for (var i = 0; i < recent.length; i++) {
        var item = recent[i];
        lastBySubject[item.subject] = item;
      }

      // Populate progress indicators
      document.querySelectorAll('.subject-progress').forEach(function(el) {
        var subjectId = el.getAttribute('data-subject');
        var item = lastBySubject[subjectId];
        if (item) {
          el.innerHTML = '<span style="color: var(--accent);">Continue &rarr;</span> <span style="color: var(--text-muted);">' + item.title + '</span>';
          el.classList.remove('hidden');
        }
      });
    })();
  </script>
</Layout>