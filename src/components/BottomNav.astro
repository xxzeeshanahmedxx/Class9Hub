<nav id="bottom-nav"
  class="sm:hidden fixed bottom-0 left-0 right-0 z-50"
  style="background: var(--header-bg); backdrop-filter: blur(24px) saturate(1.2); -webkit-backdrop-filter: blur(24px) saturate(1.2); border-top: 1px solid var(--border); padding-bottom: env(safe-area-inset-bottom, 0px);"
>
  <div class="flex items-end justify-around pb-1.5 pt-1.5 px-2" style="height: calc(56px + env(safe-area-inset-bottom, 0px));">
    <a
      href="/"
      class="flex flex-col items-center gap-0.5 active:scale-90 transition-transform duration-150 min-w-[56px] touch-min"
      aria-label="Home"
    >
      <span
        class="text-[22px] font-bold leading-none gradient-brand"
        style="-webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      >9</span>
      <span class="text-[10px] font-medium leading-tight" style="color: var(--text-muted);">Home</span>
    </a>

    <a
      href="/search/"
      class="flex flex-col items-center gap-0.5 active:scale-90 transition-transform duration-150 min-w-[56px] touch-min"
      aria-label="Search lectures"
      style="color: var(--text-muted);"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <span class="text-[10px] font-medium leading-tight" style="color: var(--text-muted);">Search</span>
    </a>


  </div>
</nav>

<script is:inline>
  (function () {
    var currentPath = window.location.pathname;
    document.querySelectorAll('#bottom-nav a[href]').forEach(function(link) {
      var href = link.getAttribute('href');
      if (href === currentPath) {
        link.setAttribute('aria-current', 'page');
      }
    });
  })();
</script>
